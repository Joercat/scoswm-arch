# scoswm configuration — copy to ~/.config/scoswm/scoswm.conf
# (or $XDG_CONFIG_HOME/scoswm/scoswm.conf). Lines are key = value.

# One of: matrix-1 (Matrix), blue-sky (Blue Sky), midnight-purple
# (Purple), amber-tech (Matrix red). These are the four SCos themes.
theme = matrix-1

# Or build a custom palette (hex RRGGBB). Setting any colour switches
# the theme to "custom"; fields you omit inherit the Matrix values.
# main       = #39FF14
# bg_top     = #031403
# bg_bot     = #000800
# win_bg     = #1a1a1a
# text       = #39FF14
# title_text = #001500
# taskbar_bg = #141414

# Programs. Empty terminal prefers the bundled scos-terminal, which runs
# a real interactive Bash. Set an explicit command to use another terminal.
# Empty files auto-detects thunar, pcmanfm, nautilus, dolphin or nemo.
# Examples: terminal = alacritty
#           terminal = xterm -fa fixed
terminal =
files =

# X core font for WM decorations and the terminal. With this empty the
# terminal prefers an ISO10646 (Unicode) fixed font from xfonts-base.
# font = -misc-fixed-medium-r-normal--14-130-75-75-c-70-iso10646-1

# Taskbar pins + desktop icons ("Home" apps). The retained SCos core
# apps are terminal, files, sysmon and settings. You may also use
# .desktop ids or app names from the standard applications
# directories, or a bare command from your own config. The easiest way
# to edit this is right-clicking an app in the launcher to pin/unpin
# it; pinned apps show their real Icon= image.
pins = terminal, files, sysmon, settings

# Taskbar height (SCos used 40).
bar_height = 40
